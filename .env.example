# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=hotel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hotel
POSTGRES_PORT=5432

# --- Server ---
# SQLAlchemy URL; must match the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://hotel:change-me@localhost:5432/hotel
# Separate database for the pytest suite (created automatically if missing).
TEST_DATABASE_URL=postgresql+asyncpg://hotel:change-me@localhost:5432/hotel_test
# Long random string; keys the hash of session tokens stored in the database.
# Changing it logs everyone out.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production refuses to start with a placeholder or anything shorter than 32 characters.
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=hotel_session
SESSION_MAX_AGE_SECONDS=28800
# Set to false only for local HTTP development (production refuses to start with false).
SESSION_COOKIE_SECURE=true
# Failed logins are throttled per username and per client IP over this window.
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_USERNAME=5
LOGIN_MAX_FAILURES_PER_IP=20
# WebSocket heartbeat interval; silent sockets are closed after two intervals.
WS_HEARTBEAT_SECONDS=25
# Queued messages allowed for one slow WebSocket client before it is disconnected.
WS_MAX_PENDING_MESSAGES=100
# Base URL of the browser app; activation and password reset links point here.
APP_BASE_URL=http://localhost:5173
# Outgoing email: "console" (prints emails to the server log, development only;
# production refuses it) or "disabled" (sends nothing; admins share links by hand).
EMAIL_BACKEND=console
EMAIL_FROM=Hotel <no-reply@hotel.local>
# Comma-separated list of allowed browser origins. Used for CORS, and to refuse
# state-changing API requests and WebSocket connections from any other origin.
# Behind a TLS-terminating proxy, list the public origin (e.g. https://hotel.example).
CORS_ORIGINS=http://localhost:5173
# IANA time zone of the hotel; defines "today" for arrivals/departures.
HOTEL_TIMEZONE=Europe/Stockholm
# Shown in the app header.
HOTEL_NAME=Grand Hotel Stockholm
# development | test | production (production hides /docs and enforces safe settings).
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Client (Vite) ---
# Backend the Vite dev server proxies /api and /ws to. The browser only talks to
# the Vite origin, so no CORS or cross-site cookies are involved in development.
BACKEND_URL=http://localhost:8000
# Only VITE_* variables are exposed to browser code; never put secrets in them.
# Poll for file changes in the Vite dev server (docker-compose sets this; host runs don't need it).
# DEV_USE_POLLING=true
